---
const { title } = Astro.props;
import Navbar from "../components/layout/Navbar.astro";
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body class="bg-bg-base text-text-primary antialiased font-sans leading-relaxed">
    <Navbar />
    <main class="pt-20 min-h-screen w-full">
      <slot />
    </main>
  </body>
</html>
